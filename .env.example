# ─── Environment ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/meeting_intelligence?schema=public"

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long-change-this
JWT_EXPIRES_IN=7d

# ─── LLM Provider (OpenRouter) ───────────────────────────────────────────────
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-ultra-253b-v1

# ─── Telegram Bot ────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ─── Submission Metadata ─────────────────────────────────────────────────────
CANDIDATE_NAME=Yashpalsingh Pawara
CANDIDATE_EMAIL=yashpalsinghpawara@gmail.com
REPOSITORY_URL=https://github.com/yashu1412/TalentIQ
